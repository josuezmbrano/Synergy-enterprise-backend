    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@project/common": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-xss-sanitizer": "^2.0.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "lodash-es": "^4.18.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.12.4",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
