{
  "name": "@project/server",
  "version": "1.0.0",
  "description": "Backend structure on clean architecture and DDD",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "NODE_ENV=development tsx watch ./src/infrastructure/http/server.ts",
    "build": "pnpm --filter @project/common run build && tsc -p tsconfig.build.json",
    "start": "node dist/infrastructure/http/server.js",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
