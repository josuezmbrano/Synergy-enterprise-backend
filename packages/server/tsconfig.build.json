{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "paths": {
            "@project/common": [
                "../common/dist/index.js"
            ],
            "@project/common/*": [
                "../common/dist/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/test/**/*"
    ]
}