# ==========================================
# STAGE 1: Build & Dependencies
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copiamos archivos de gestión de dependencias
COPY package.json pnpm-lock.yaml* ./

# Instalamos TODAS las dependencias (incluyendo devDependencies para compilar)
RUN corepack enable && pnpm install --frozen-lockfile

# Copiamos el código fuente y esquema de Prisma si aplica
COPY . .

# Generamos el cliente de Prisma y compilamos TypeScript a JavaScript (/dist)
RUN npx prisma generate
RUN pnpm build

# Limpiamos dependencias de desarrollo para dejar solo las de producción
RUN pnpm prune --prod

# ==========================================
# STAGE 2: Production Runner (Imagen Final)
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /app

# Seteamos el entorno a producción
ENV NODE_ENV=production

# BUENA PRÁCTICA DE SEGURIDAD:
# Creamos un usuario sin privilegios de root para ejecutar la app
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 synergyuser

# Copiamos solo lo estrictamente necesario desde el STAGE 1 (builder)
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# Asignamos permisos del directorio al usuario no-root
USER synergyuser

# Exponemos el puerto operacional
EXPOSE 3000

# Comando de arranque de la aplicación
CMD ["node", "dist/main.js"]