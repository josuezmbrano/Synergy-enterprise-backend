{
  "name": "enterprise-project-system",
  "private": true,
  "version": "1.0.0",
  "description": "Project Management System Backend",
  "main": "index.js",
  "scripts": {
    "dev:server": "dotenv -e .env -e packages/server/.env -- pnpm --filter @project/server dev",
    "start:server": "dotenv -e .env -e packages/server/.env -- pnpm --filter @project/server start",
    "server:prisma-generate": "dotenv -e .env -e packages/server/.env -- pnpm --filter @project/server prisma:generate",
    "server:prisma-migrate-deploy": "dotenv -e .env -e packages/server/.env -- pnpm --filter @project/server prisma:migrate-deploy",
    "test:unit": "pnpm --filter @project/server test:unit",
    "test:integration": "pnpm --filter @project/server test:integration",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck:all",
    "typecheck:build": "pnpm -r typecheck:build"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "lodash": "^4.18.0",
      "hono": "^4.12.25",
      "fast-uri": "^3.1.5",
      "deepmerge-ts": "^8.0.0",
      "mysql2": "^3.22.0"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}